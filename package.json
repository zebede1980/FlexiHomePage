{
  "name": "flexihome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A home page built on your bookmarks: a browser extension, or a site you host.",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "dev:server": "PORT=3031 tsx watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist-server/index.js",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.64.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5"
  },
  "engines": {
    "node": ">=22"
  }
}
